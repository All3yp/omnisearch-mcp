# Email address used as the User-Agent contact for academic APIs (CrossRef, etc.)
CONTACT_EMAIL=your.email@example.com

# --- APIs Oficiais ---
# Chave oficial do IEEE Xplore (Opcional se usar CAPES_PROXY_URL / IEEE_COOKIES)
IEEE_XPLORE_API_KEY=

# Chave do Semantic Scholar (Opcional, mas evita limites)
SEMANTIC_SCHOLAR_API_KEY=

# Chave v3 do CORE (Necessária para buscas no core.ac.uk)
CORE_API_KEY=

# --- Automação do Login CAPES (CAFe) ---
# Preencha para usar o `omnisearch-capes-login` em modo automatizado (ou headless)
CAFE_INSTITUTION_ID=
CAFE_USERNAME=
CAFE_PASSWORD=

SCITE_EMAIL=
SCITE_PASS=

CONSENSUS_EMAIL=
CONSENSUS_PASS=

# Browser Path for Automation (Optional, leave blank to use Playwright's default chromium)
# Windows Example: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# Linux Example: /usr/bin/google-chrome
PLAYWRIGHT_BROWSER_PATH=

# --- Sessões de Login (Web Scraping / Contorno) ---

# Você não precisa preencher manualmente!
# Rode os scripts `uv run ieee-...-login` e eles preencherão os cookies abaixo automaticamente.

CAPES_PROXY_URL=
IEEE_COOKIES=
SCITE_COOKIES=
CONSENSUS_COOKIES=
